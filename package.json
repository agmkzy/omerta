{
  "name": "omerta",
  "version": "0.85.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "description": "OMERT\u00c0 - a single-player sandbox mafia RPG simulation (engine + text UI)",
  "scripts": {
    "sim": "tsx src/cli.ts sim",
    "play": "tsx src/cli.ts play",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:unit": "vitest run --tagsFilter unit",
    "test:compat": "vitest run --tagsFilter compat",
    "test:slow": "SLOW=1 vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "bot": "tsx src/bot.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "playtest": "tsx playtest/pt.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
